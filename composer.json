{
    "name": "koakademy/notification-center",
    "description": "Template-based notification management and bulk messaging tools.",
    "type": "library",
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "KoAkademy contributors"
        }
    ],
    "require": {
        "php": ">=8.5.12 <8.6",
        "filament/filament": "^5.0",
        "laravel/framework": "^13.0",
        "nwidart/laravel-modules": "^13.0",
        "spatie/laravel-permission": "^6.21",
        "inertiajs/inertia-laravel": "^3.0"
    },
    "require-dev": {
        "pestphp/pest": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Modules\\NotificationCenter\\": "app/",
            "Modules\\NotificationCenter\\Database\\Factories\\": "database/factories/",
            "Modules\\NotificationCenter\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Modules\\NotificationCenter\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Modules\\NotificationCenter\\Providers\\NotificationCenterServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "scripts": {
        "test": "pest --compact tests/Unit/PackageContractTest.php"
    }
}
